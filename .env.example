# ─── Email (Resend — для отправки кодов) ─────────────────────────
# Получите API-ключ на https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key
# Необязательно: сколько писем РАССЫЛОК можно отправить за скользящие 24 часа
# (админка → «Рассылки и начисления»). По умолчанию 80: квота бесплатного
# Resend — 100 в сутки на всё, и 20 остаются кодам входа. На платном
# тарифе поставьте по тарифу.
RESEND_DAILY_LIMIT=

# ─── Database (PostgreSQL) ───────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/atlas_secure

# ─── Application ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Atlas Secure
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Публичный адрес сайта: ссылки в письмах и returnUrl после оплаты.
# Без него returnUrl строится из заголовка Origin (с предупреждением в логе).
SITE_BASE_URL=https://atlassecure.uk
# Необязательно: запасной адрес сайта (канонические ссылки / SEO).
NEXT_PUBLIC_SITE_URL=
# Домены, с которых разрешён вход по коду (server actions), через запятую.
# Свои домены atlassecure.uk/.ru и *.up.railway.app уже в next.config.ts;
# сюда — только дополнительные. Без этого вход падает с кодом E80.
SERVER_ACTIONS_ALLOWED_ORIGINS=

# ─── Admin ───────────────────────────────────────────────────────
# Email администратора: доступ к /admin и /api/admin/*.
ADMIN_EMAIL=admin@example.com
# Необязательно: куда слать алерты (возвраты). По умолчанию ADMIN_EMAIL.
ADMIN_NOTIFY_EMAIL=

# ─── Remnawave panel (3.4.3) ─────────────────────────────────────
# Адрес панели (публичный HTTPS). По умолчанию https://rmnw.atlassecure.ru.
REMNAWAVE_API_URL=https://rmnw.atlassecure.ru
# API-токен панели (Settings → API tokens). Обязателен.
REMNAWAVE_API_TOKEN=your-remnawave-api-token
# Internal squad(s) для пользователей сайта, через запятую.
# По умолчанию 2c8eba36-6e74-45b1-af5e-54ea0e65e19d.
REMNAWAVE_MAINSERVER_SQUAD_UUID=2c8eba36-6e74-45b1-af5e-54ea0e65e19d
# Необязательно: свои squads по тарифу (иначе — MAINSERVER). Если задан хоть
# один, синхронизация переносит пользователя между squads при смене тарифа.
REMNAWAVE_SQUAD_TRIAL=
REMNAWAVE_SQUAD_BASIC=
REMNAWAVE_SQUAD_PLUS=
# Необязательно: отправлять X-Forwarded-For/-Proto (панель без них рвёт
# соединение, если к ней ходят в обход reverse proxy). По умолчанию true.
REMNAWAVE_FORWARDED_HEADERS=true
# Необязательно: секрет вебхуков панели (WEBHOOK_SECRET_HEADER в панели,
# ≥32 латинских букв/цифр). Пусто — /api/panel/webhook отвечает 404.
REMNAWAVE_WEBHOOK_SECRET=

# ─── YooKassa (оплата) ───────────────────────────────────────────
YOOKASSA_SHOP_ID=your-shop-id
YOOKASSA_SECRET_KEY=your-secret-key

# ─── Platega (оплата по карте, модуль src/lib/platega.ts) ────────
PLATEGA_MERCHANT_ID=your-merchant-id
PLATEGA_SECRET=your-secret-key

# ─── Telegram Bot Sync ───────────────────────────────────────────
# Секретный ключ для API бота (общий между ботом и сайтом)
# Сгенерируйте: openssl rand -hex 32
BOT_API_KEY=your-bot-api-key
# Необязательно: имя бота без @ — кнопка «Привязать Telegram» в кабинете
# открывает https://t.me/<бот>?start=link_<токен>. Пусто — atlassecure_bot
# (DEFAULT_BOT_USERNAME). Контракт: docs/bot/TZ_BOT_EMAIL_LINK.md
TELEGRAM_BOT_USERNAME=
# Необязательно: шаблоны username сущностей бота в панели (как у бота:
# REMNAWAVE_PREMIUM_USERNAME_PATTERN / REMNAWAVE_BYPASS_USERNAME_PATTERN).
# По умолчанию tg_{telegram_id}_premium и {telegram_id}.
BOT_PREMIUM_USERNAME_PATTERN=
BOT_BYPASS_USERNAME_PATTERN=
# Необязательно: сквад и лимит устройств сущностей обхода («Пакеты
# трафика», следующая фаза) — те же, что у бота. По умолчанию
# 6947418d-83b6-4050-a10c-3829e4cd4b2c и 5.
REMNAWAVE_BYPASS_SQUAD_UUID=6947418d-83b6-4050-a10c-3829e4cd4b2c
REMNAWAVE_BYPASS_DEVICE_LIMIT=5

# ─── Cron ────────────────────────────────────────────────────────
# Обязателен для /api/cron/*: без него эндпоинт отвечает 503.
CRON_SECRET=your-cron-secret

# ─── Web Push ────────────────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=

# ─── Passkeys ────────────────────────────────────────────────────
PASSKEY_RP_ID=
